<?xml version="1.0"?>
<!-- tabletop_furinno.world — variant of tabletop.world with the real-product
     Furinno Hermite shelf twin instead of the synthetic bookshelf (AURA-753).
     Everything else (table, plank, objects, cameras, physics) is identical. -->
<sdf version="1.6">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gui fullscreen="0">

      <!-- 3D scene -->
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>

        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <!-- GUI 3D view starts from the scene/wall camera's vantage (matches the
             scene_camera model pose) so the operator sees what the scene camera records. -->
        <camera_pose>0.30 0.72 0.65 0 0.30 -1.5708</camera_pose>
        <camera_clip>
          <near>0.25</near>
          <far>25000</far>
        </camera_clip>
      </plugin>

      <!-- Plugins that add functionality to the scene -->
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <anchors target="Select entities">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="Spawn" name="Spawn Entities">
        <gz-gui>
          <anchors target="Select entities">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <!-- World control -->
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">180</property>
          <property type="double" key="z">1</property>

          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>

        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
        <use_event>true</use_event>

      </plugin>

      <!-- World statistics -->
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>

          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>

        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <!-- Insert simple shapes -->
      <plugin filename="Shapes" name="Shapes">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">0</property>
          <property key="y" type="double">0</property>
          <property key="width" type="double">250</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#666666</property>
        </gz-gui>
      </plugin>

      <!-- Insert lights -->
      <plugin filename="Lights" name="Lights">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">250</property>
          <property key="y" type="double">0</property>
          <property key="width" type="double">150</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#666666</property>
        </gz-gui>
      </plugin>

      <!-- Translate / rotate -->
      <plugin filename="TransformControl" name="Transform control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">0</property>
          <property key="y" type="double">50</property>
          <property key="width" type="double">250</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#777777</property>
        </gz-gui>
      </plugin>

      <!-- Screenshot -->
      <plugin filename="Screenshot" name="Screenshot">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">250</property>
          <property key="y" type="double">50</property>
          <property key="width" type="double">50</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#777777</property>
        </gz-gui>
      </plugin>

      <!-- Video recorder -->
      <plugin filename="VideoRecorder" name="VideoRecorder">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">300</property>
          <property key="y" type="double">50</property>
          <property key="width" type="double">50</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#777777</property>
        </gz-gui>

        <record_video>
          <use_sim_time>true</use_sim_time>
          <lockstep>true</lockstep>
          <bitrate>4000000</bitrate>
        </record_video>
      </plugin>

      <!-- Inspector -->
      <plugin filename="ComponentInspector" name="Component inspector">
        <gz-gui>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
      </plugin>

      <!-- Entity tree -->
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
      </plugin>

      <!-- View angle -->
      <plugin filename="ViewAngle" name="View angle">
        <gz-gui>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
      </plugin>

    </gui>

    <!-- Server-side systems. Sensors must be declared explicitly so that the
         render engine (ogre2) is initialised on the server — without this,
         camera sensors create their topic but never publish frames. -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Fill light to reduce harsh shadows -->
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0.3 -0.2 -0.9</direction>
    </light>

    <!--
      Coordinate layout (matching real robot setup):
        Robot base spawned at world origin (0, 0, 0).
        Plank top surface = Z=0  (robot sits directly on the plank)
        Plank thickness   = 0.04 m  -> plank center Z = -0.02
        Table top surface = Z=-0.04 -> table top center Z = -0.055
        Table leg height  = 0.695 m -> leg center Z = -0.0725 - 0.3475 = -0.42
        Floor             = Z = -0.77

        X axis runs along the length of the table / plank.
        Robot sits at X=0, roughly left-third of the plank.
        Plank size     = 1.218 x 0.285 x 0.04 m (121.8 x 28.5 x 4 cm board)
        Plank center X = 0.2 (extends -0.409 to +0.809 relative to robot).
        Table center X = 0.2.

        Camera at Y=-1.6 looks in the +Y direction toward the robot.
        Background wall at Y=+0.75.
    -->

    <!-- ===== FLOOR (dark carpet) ===== -->
    <model name="floor">
      <static>true</static>
      <pose>0.2 0 -0.77 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>6.0 5.0 0.01</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6.0 5.0 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.22 0.22 0.24 1</ambient>
            <diffuse>0.26 0.26 0.28 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== TABLE ===== -->
    <!-- White lab/work table with four cylindrical metal legs -->
    <model name="table">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">

        <!-- Table top surface (white) -->
        <collision name="tabletop_col">
          <pose>0.2 0 -0.055 0 0 0</pose>
          <geometry><box><size>1.6 1.25 0.03</size></box></geometry>
        </collision>
        <visual name="tabletop_vis">
          <pose>0.2 0 -0.055 0 0 0</pose>
          <geometry><box><size>1.6 1.25 0.03</size></box></geometry>
          <material>
            <ambient>0.94 0.94 0.93 1</ambient>
            <diffuse>0.96 0.96 0.95 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>

        <!-- Leg: front-left -->
        <collision name="leg_fl_col">
          <pose>-0.55 -0.375 -0.42 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.695</length></cylinder></geometry>
        </collision>
        <visual name="leg_fl_vis">
          <pose>-0.55 -0.375 -0.42 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.695</length></cylinder></geometry>
          <material>
            <ambient>0.55 0.55 0.60 1</ambient>
            <diffuse>0.65 0.65 0.70 1</diffuse>
            <specular>0.85 0.85 0.90 1</specular>
          </material>
        </visual>

        <!-- Leg: front-right -->
        <collision name="leg_fr_col">
          <pose>-0.55 0.375 -0.42 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.695</length></cylinder></geometry>
        </collision>
        <visual name="leg_fr_vis">
          <pose>-0.55 0.375 -0.42 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.695</length></cylinder></geometry>
          <material>
            <ambient>0.55 0.55 0.60 1</ambient>
            <diffuse>0.65 0.65 0.70 1</diffuse>
            <specular>0.85 0.85 0.90 1</specular>
          </material>
        </visual>

        <!-- Leg: back-left -->
        <collision name="leg_bl_col">
          <pose>0.95 -0.375 -0.42 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.695</length></cylinder></geometry>
        </collision>
        <visual name="leg_bl_vis">
          <pose>0.95 -0.375 -0.42 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.695</length></cylinder></geometry>
          <material>
            <ambient>0.55 0.55 0.60 1</ambient>
            <diffuse>0.65 0.65 0.70 1</diffuse>
            <specular>0.85 0.85 0.90 1</specular>
          </material>
        </visual>

        <!-- Leg: back-right -->
        <collision name="leg_br_col">
          <pose>0.95 0.375 -0.42 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.695</length></cylinder></geometry>
        </collision>
        <visual name="leg_br_vis">
          <pose>0.95 0.375 -0.42 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.695</length></cylinder></geometry>
          <material>
            <ambient>0.55 0.55 0.60 1</ambient>
            <diffuse>0.65 0.65 0.70 1</diffuse>
            <specular>0.85 0.85 0.90 1</specular>
          </material>
        </visual>

        <!-- Lower cross-bar connecting front legs -->
        <visual name="crossbar_front_vis">
          <pose>-0.55 0 -0.68 0 0 0</pose>
          <geometry><box><size>0.04 0.71 0.03</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.60 1</ambient>
            <diffuse>0.65 0.65 0.70 1</diffuse>
            <specular>0.85 0.85 0.90 1</specular>
          </material>
        </visual>

        <!-- Lower cross-bar connecting back legs -->
        <visual name="crossbar_back_vis">
          <pose>0.95 0 -0.68 0 0 0</pose>
          <geometry><box><size>0.04 0.71 0.03</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.60 1</ambient>
            <diffuse>0.65 0.65 0.70 1</diffuse>
            <specular>0.85 0.85 0.90 1</specular>
          </material>
        </visual>

      </link>
    </model>

    <!-- ===== WOODEN PLANK ===== -->
    <!--
      Light pine/plywood board the robot is mounted on.
      Top surface at Z=0 so the robot (spawned at origin) sits on top.
      Real board: 121.8 cm x 28.5 cm x 4 cm.
      Extends from X=-0.409 (left of robot) to X=+0.809 (right, where objects sit).
    -->
    <model name="wooden_plank">
      <static>true</static>
      <!-- Centred under the arm (Y=0). Separation from the shelf comes from
           the shelf being moved out to Y=-0.45, not from offsetting the mount. -->
      <pose>0.2 0 -0.02 0 0 0</pose>
      <link name="link">
        <!-- 240 mm deep collision prevents objects from tunnelling through under
             gravity. Top face sits at world Z=0 (plank surface); the box extends
             downward invisibly. X/Y is inset 3 cm vs the visual so the gripper
             can sit near the plank edge without generating a hard contact stop.
             High kp/kd prevents objects sinking when the gripper presses down. -->
        <collision name="collision">
          <pose>0 0 -0.10 0 0 0</pose>
          <geometry><box><size>1.158 0.225 0.24</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <bounce><restitution_coefficient>0</restitution_coefficient><threshold>1e6</threshold></bounce>
            <contact>
              <collide_bitmask>0x0001</collide_bitmask>
              <ode><kp>1000000</kp><kd>100</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.218 0.285 0.04</size></box></geometry>
          <material>
            <!-- Light pine / natural wood colour -->
            <ambient>0.72 0.55 0.33 1</ambient>
            <diffuse>0.76 0.60 0.38 1</diffuse>
            <specular>0.08 0.06 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== PICK-AND-PLACE OBJECTS (on plank, to the right of robot) ===== -->
    <!--
      Smaller, varied-shape objects optimised for SmolVLA pick-and-place.
      Non-static so the robot can physically move them.
      Gravity is enabled — objects rest on the plank and fall if knocked off.
      Solid opaque colours give the vision model clear contrast.
      Pick zone: X=0.47-0.65, Y=-0.05 to 0.08, plank surface Z=0.
    -->

    <!-- Teal block - 23×20×22 mm, same geometry as purple/orange.
         Placed closer to the robot (X=0.43) to avoid overlap with the orange block. -->
    <model name="block_teal">
      <static>false</static>
      <pose>0.38 0.06 0.011 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>7.37e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>8.44e-6</iyy><iyz>0</iyz>
            <izz>7.74e-6</izz>
          </inertia>
        </inertial>
        <!-- kp/kd matched to jaw surfaces (200000/100) — symmetric stiffness prevents
             asymmetric jaw forces from spinning the block during grasping.
             min_depth/max_vel matched to jaw minDepth/maxVel for consistent contact. -->
        <!-- angular decay 5.0 → exp(-5) ≈ 0.7% remaining per second.
             At c=0.05 the block could reach ~1 rad/s from an asymmetric jaw
             contact, spinning 45° in under a second before the jaws closed —
             exactly the corner-catch failure in the screenshot.  c=5.0 limits
             steady-state spin to <0.01 rad/s under the same torque. -->
        <velocity_decay>
          <angular>5.0</angular>
        </velocity_decay>
        <collision name="collision">
          <geometry><box><size>0.023 0.020 0.022</size></box></geometry>
          <surface>
            <friction><ode><mu>2.5</mu><mu2>2.5</mu2></ode></friction>
            <bounce><restitution_coefficient>0</restitution_coefficient><threshold>1e6</threshold></bounce>
            <contact><ode><kp>100000</kp><kd>50</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.023 0.020 0.022</size></box></geometry>
          <material>
            <ambient>0.00 0.60 0.70 1</ambient>
            <diffuse>0.00 0.72 0.82 1</diffuse>
            <specular>0.30 0.60 0.70 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Purple rectangular block - 23 x 20 x 22 mm.
         All cross-section dims (23 mm and 20 mm) < 27.6 mm jaw gap, so the block
         is graspable from all four vertical sides.  Previous size (40 x 22 x 18 mm)
         had a 40 mm face that exceeded the jaw opening — only 2 of 4 sides worked. -->
    <model name="block_purple">
      <static>false</static>
      <pose>0.43 -0.02 0.011 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>7.37e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>8.44e-6</iyy><iyz>0</iyz>
            <izz>7.74e-6</izz>
          </inertia>
        </inertial>
        <!-- angular decay 5.0 → exp(-5) ≈ 0.7% remaining per second.
             At c=0.05 the block could reach ~1 rad/s from an asymmetric jaw
             contact, spinning 45° in under a second before the jaws closed —
             exactly the corner-catch failure in the screenshot.  c=5.0 limits
             steady-state spin to <0.01 rad/s under the same torque. -->
        <velocity_decay>
          <angular>5.0</angular>
        </velocity_decay>
        <collision name="collision">
          <geometry><box><size>0.023 0.020 0.022</size></box></geometry>
          <surface>
            <friction><ode><mu>2.5</mu><mu2>2.5</mu2></ode></friction>
            <bounce><restitution_coefficient>0</restitution_coefficient><threshold>1e6</threshold></bounce>
            <contact><ode><kp>100000</kp><kd>50</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.023 0.020 0.022</size></box></geometry>
          <material>
            <ambient>0.55 0.00 0.70 1</ambient>
            <diffuse>0.62 0.08 0.80 1</diffuse>
            <specular>0.60 0.30 0.70 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Orange block - 23×20×22 mm, same geometry as purple/teal. -->
    <model name="block_orange">
      <static>false</static>
      <pose>0.49 0.07 0.011 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>7.37e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>8.44e-6</iyy><iyz>0</iyz>
            <izz>7.74e-6</izz>
          </inertia>
        </inertial>
        <!-- angular decay 5.0 → exp(-5) ≈ 0.7% remaining per second.
             At c=0.05 the block could reach ~1 rad/s from an asymmetric jaw
             contact, spinning 45° in under a second before the jaws closed —
             exactly the corner-catch failure in the screenshot.  c=5.0 limits
             steady-state spin to <0.01 rad/s under the same torque. -->
        <velocity_decay>
          <angular>5.0</angular>
        </velocity_decay>
        <collision name="collision">
          <geometry><box><size>0.023 0.020 0.022</size></box></geometry>
          <surface>
            <friction><ode><mu>2.5</mu><mu2>2.5</mu2></ode></friction>
            <bounce><restitution_coefficient>0</restitution_coefficient><threshold>1e6</threshold></bounce>
            <contact><ode><kp>100000</kp><kd>50</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.023 0.020 0.022</size></box></geometry>
          <material>
            <ambient>0.90 0.40 0.00 1</ambient>
            <diffuse>0.95 0.52 0.00 1</diffuse>
            <specular>0.70 0.50 0.10 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== VARIED-SHAPE OBJECTS (shape generalization for VLA) =====
         Cylinder + sphere are SDF primitives; hexagonal prism + triangular prism
         (pentahedron) are convex STL meshes generated by data/gen_meshes.py. All
         sized so the grip dimension is ~22 mm (< the ~28 mm jaw opening). Same
         mass/friction/contact tuning as the cubes. The meshes are live-mounted into
         the gz share path (see docker-compose sim-tabletop). -->
    <model name="cylinder_red">
      <static>false</static>
      <pose>0.52 0.12 0.012 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass>
          <inertia><ixx>7.5e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>7.5e-6</iyy><iyz>0</iyz><izz>7.2e-6</izz></inertia>
        </inertial>
        <velocity_decay><angular>5.0</angular></velocity_decay>
        <!-- Box COLLISION (bounding the diameter) — the cylinder PRIMITIVE collision is
             unstable in this physics engine and explodes on spawn; a box is stable like
             the cubes. The visual below stays a round cylinder (what the camera sees).
             Contact params matched to the cube blocks. -->
        <collision name="collision">
          <geometry><box><size>0.024 0.024 0.024</size></box></geometry>
          <surface>
            <friction><ode><mu>2.5</mu><mu2>2.5</mu2></ode></friction>
            <bounce><restitution_coefficient>0</restitution_coefficient><threshold>1e6</threshold></bounce>
            <contact><ode><kp>100000</kp><kd>50</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.012</radius><length>0.024</length></cylinder></geometry>
          <material><ambient>0.80 0.10 0.10 1</ambient><diffuse>0.90 0.15 0.15 1</diffuse><specular>0.6 0.3 0.3 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="hex_prism">
      <static>false</static>
      <pose>0.60 -0.04 0.012 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass>
          <inertia><ixx>7.5e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>7.5e-6</iyy><iyz>0</iyz><izz>7.5e-6</izz></inertia>
        </inertial>
        <velocity_decay><angular>5.0</angular></velocity_decay>
        <!-- Box COLLISION bounding the hex (across-corners X 0.0254, across-flats Y
             0.022, height Z 0.024); mesh-vs-jaw contact slips, a box grips like the
             cubes. Visual below stays the true hex mesh (what the camera sees). -->
        <collision name="collision">
          <geometry><box><size>0.0254 0.022 0.024</size></box></geometry>
          <surface>
            <friction><ode><mu>2.5</mu><mu2>2.5</mu2></ode></friction>
            <bounce><restitution_coefficient>0</restitution_coefficient><threshold>1e6</threshold></bounce>
            <contact><ode><kp>100000</kp><kd>50</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><mesh><uri>file:///ar4_ws/install/annin_ar4_gazebo/share/annin_ar4_gazebo/meshes/hex_prism.stl</uri></mesh></geometry>
          <material><ambient>0.10 0.55 0.20 1</ambient><diffuse>0.15 0.70 0.25 1</diffuse><specular>0.3 0.6 0.3 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="tri_prism">
      <static>false</static>
      <pose>0.60 0.04 0.014 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass>
          <inertia><ixx>7.0e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>7.0e-6</iyy><iyz>0</iyz><izz>7.0e-6</izz></inertia>
        </inertial>
        <velocity_decay><angular>5.0</angular></velocity_decay>
        <!-- Box COLLISION bounding the tri prism (X 0.024, Y 0.022 between the vertical
             triangular caps = grip dim, Z 0.0277 height); mesh-vs-jaw contact slips, a
             box grips like the cubes. Visual below stays the true tri mesh. -->
        <collision name="collision">
          <geometry><box><size>0.0277 0.022 0.024</size></box></geometry>
          <surface>
            <friction><ode><mu>2.5</mu><mu2>2.5</mu2></ode></friction>
            <bounce><restitution_coefficient>0</restitution_coefficient><threshold>1e6</threshold></bounce>
            <contact><ode><kp>100000</kp><kd>50</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><mesh><uri>file:///ar4_ws/install/annin_ar4_gazebo/share/annin_ar4_gazebo/meshes/tri_prism.stl</uri></mesh></geometry>
          <material><ambient>0.20 0.30 0.75 1</ambient><diffuse>0.25 0.40 0.90 1</diffuse><specular>0.3 0.3 0.6 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- ===== FURINNO HERMITE SHELF (real-product twin, AURA-753) ===== -->
    <model name="furinno_shelf">
      <static>true</static>
      <!-- Real-product twin (AURA-753): Furinno Hermite 16.4x7.8x9.25in, grey oak,
           10mm panels. Stands on its side panels; two shelf boards + usable top;
           center divider splits the LOWER tier into two cubbies. Geometry mirrors
           models/furinno_shelf/model.sdf (keep in sync).
           Placement surfaces (world z): lower cubbies +0.025 (60mm clear — tight),
           upper tier +0.095 (90mm clear), top surface +0.195 (open air). -->
      <pose>0.30 -0.45 -0.04 0 0 0</pose>
      <link name="link">

      <collision name="side_l_col">
        <pose>-0.2035 0 0.1175 0 0 0</pose>
        <geometry><box><size>0.010 0.198 0.235</size></box></geometry>
        <surface><contact><collide_bitmask>0x0001</collide_bitmask></contact></surface>
      </collision>
      <visual name="side_l_vis">
        <pose>-0.2035 0 0.1175 0 0 0</pose>
        <geometry><box><size>0.010 0.198 0.235</size></box></geometry>
        <material>
          <ambient>0.45 0.44 0.42 1</ambient>
          <diffuse>0.58 0.56 0.53 1</diffuse>
          <specular>0.12 0.12 0.12 1</specular>
        </material>
      </visual>

      <collision name="side_r_col">
        <pose>0.2035 0 0.1175 0 0 0</pose>
        <geometry><box><size>0.010 0.198 0.235</size></box></geometry>
        <surface><contact><collide_bitmask>0x0001</collide_bitmask></contact></surface>
      </collision>
      <visual name="side_r_vis">
        <pose>0.2035 0 0.1175 0 0 0</pose>
        <geometry><box><size>0.010 0.198 0.235</size></box></geometry>
        <material>
          <ambient>0.45 0.44 0.42 1</ambient>
          <diffuse>0.58 0.56 0.53 1</diffuse>
          <specular>0.12 0.12 0.12 1</specular>
        </material>
      </visual>

      <collision name="top_col">
        <pose>0 0 0.230 0 0 0</pose>
        <geometry><box><size>0.417 0.198 0.010</size></box></geometry>
        <surface><contact><collide_bitmask>0x0001</collide_bitmask></contact></surface>
      </collision>
      <visual name="top_vis">
        <pose>0 0 0.230 0 0 0</pose>
        <geometry><box><size>0.417 0.198 0.010</size></box></geometry>
        <material>
          <ambient>0.45 0.44 0.42 1</ambient>
          <diffuse>0.58 0.56 0.53 1</diffuse>
          <specular>0.12 0.12 0.12 1</specular>
        </material>
      </visual>

      <collision name="mid_shelf_col">
        <pose>0 0 0.130 0 0 0</pose>
        <geometry><box><size>0.397 0.198 0.010</size></box></geometry>
        <surface><contact><collide_bitmask>0x0001</collide_bitmask></contact></surface>
      </collision>
      <visual name="mid_shelf_vis">
        <pose>0 0 0.130 0 0 0</pose>
        <geometry><box><size>0.397 0.198 0.010</size></box></geometry>
        <material>
          <ambient>0.45 0.44 0.42 1</ambient>
          <diffuse>0.58 0.56 0.53 1</diffuse>
          <specular>0.12 0.12 0.12 1</specular>
        </material>
      </visual>

      <collision name="low_shelf_col">
        <pose>0 0 0.060 0 0 0</pose>
        <geometry><box><size>0.397 0.198 0.010</size></box></geometry>
        <surface><contact><collide_bitmask>0x0001</collide_bitmask></contact></surface>
      </collision>
      <visual name="low_shelf_vis">
        <pose>0 0 0.060 0 0 0</pose>
        <geometry><box><size>0.397 0.198 0.010</size></box></geometry>
        <material>
          <ambient>0.45 0.44 0.42 1</ambient>
          <diffuse>0.58 0.56 0.53 1</diffuse>
          <specular>0.12 0.12 0.12 1</specular>
        </material>
      </visual>

      <collision name="divider_col">
        <pose>0 0 0.0625 0 0 0</pose>
        <geometry><box><size>0.010 0.198 0.125</size></box></geometry>
        <surface><contact><collide_bitmask>0x0001</collide_bitmask></contact></surface>
      </collision>
      <visual name="divider_vis">
        <pose>0 0 0.0625 0 0 0</pose>
        <geometry><box><size>0.010 0.198 0.125</size></box></geometry>
        <material>
          <ambient>0.45 0.44 0.42 1</ambient>
          <diffuse>0.58 0.56 0.53 1</diffuse>
          <specular>0.12 0.12 0.12 1</specular>
        </material>
      </visual>

    </link>
    </model>

    <!-- ===== BACKGROUND WALL ===== -->
    <!-- White painted wall behind the robot setup -->
    <model name="back_wall">
      <static>true</static>
      <pose>0.2 0.75 0.23 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.5 0.02 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.5 0.02 2.0</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Side wall (left, from camera perspective) -->
    <model name="left_wall">
      <static>true</static>
      <pose>-1.4 0 0.23 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.02 3.0 2.0</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== AXIS SCENE CAMERA (third-person) =====
         Mirrors the real lab: an Axis camera wall-mounted parallel to the table,
         to the side of the arm. Mounted on the +Y wall looking across the table
         in -Y, so it sees the pick area (+Y) → arm → shelf (-Y) in profile.
         Publishes /scene_camera/image (bridged in config/bridge.yaml). -->
    <model name="scene_camera">
      <static>true</static>
      <pose>0.30 0.72 0.65 0 0.30 -1.5708</pose>
      <link name="link">
        <visual name="body">
          <geometry><box><size>0.06 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.10 0.10 0.10 1</diffuse>
          </material>
        </visual>
        <sensor name="scene_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.4</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>12.0</far></clip>
          </camera>
          <topic>/scene_camera/image</topic>
          <gz_frame_id>scene_camera</gz_frame_id>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
